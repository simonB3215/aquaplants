# AquaPlants en la nube: Supabase (PostgreSQL principal) + Neon (payloads crudos, en vez de MongoDB).
# COPIAR a .env.nube y completar. DATABASE_URL = Supabase → Connect → Session pooler (NO «Direct»: no funciona desde Render).
# El certificado público de Supabase ya está en certificados/supabase-ca.crt (ruta relativa al proyecto: sirve en cualquier computador y en Render).
# Si la clave tiene @ : / # ? & o %, escríbala codificada (p. ej. @ → %40).
DATABASE_URL=postgresql://postgres.<ref-proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certificados/supabase-ca.crt
PAYLOADS_DATABASE_URL=postgresql://<usuario>:<clave>@<host>.neon.tech/neondb?sslmode=verify-full&channel_binding=require

NODE_ENV=development
PORT=3000
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Minutos de validez del enlace de «¿Olvidó su contraseña?»
RESTABLECER_MINUTOS=30
WORKER_EN_API=true
WORKER_SIN_SENAL_CADA_S=10
# RN-04: «sin señal» tras N intervalos sin comunicación (WORKER_SIN_SENAL_CADA_S debe ser menor que N × intervalo)
SIN_SENAL_FACTOR=3
DEMO_MODE=true
SIM_CONTROL_URL=http://localhost:4100
SIM_CONTROL_TOKEN=cambiar-token-control-simulador
DEMO_ENCARGADO_EMAIL=encargado@aquaplants.cl
DEMO_ENCARGADO_PASSWORD=EncargadoAqua2026
DEVICE_RATE_LIMIT_PER_MIN=30

# Correo (opcional; sin SMTP las alertas quedan «proveedor no configurado»)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Render free bloquea SMTP (25/465/587): en Render usar la API HTTP de Resend.
# Si RESEND_API_KEY está definida se ignora SMTP_*. Sin dominio propio, Resend solo
# entrega al correo dueño de la cuenta (debe ser el de NOTIFICACIONES_SOLO_A).
RESEND_API_KEY=
# RESEND_FROM=AquaPlants <onboarding@resend.dev>
# Solo demo: enviar TODOS los avisos únicamente a esta dirección (los usuarios sembrados son ficticios).
NOTIFICACIONES_SOLO_A=

# Seed (datos de prueba para la presentación)
SEED_INTERVALO_S=10
SEED_PASSWORD_ADMIN=AdminAqua2026
SEED_PASSWORD_SUPERVISOR=SuperAqua2026
SEED_PASSWORD_ENCARGADO=EncargadoAqua2026

# Simulador
API_URL=http://localhost:3000/api/v1
SIM_BACKOFF_BASE_MS=3000
