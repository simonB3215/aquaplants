# ======= AquaPlants — variables de entorno (COPIAR a .env y cambiar TODOS los secretos) =======
NODE_ENV=development
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

POSTGRES_USER=aquaplants
POSTGRES_PASSWORD=cambiar-esta-clave-pg
POSTGRES_DB=aquaplants

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambiar-esta-clave-mongo-root
MONGO_APP_USER=aquaplants_app
MONGO_APP_PASSWORD=cambiar-esta-clave-mongo-app

# Mínimo 32 caracteres aleatorios (p. ej. `openssl rand -base64 48`)
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Límite por dispositivo autenticado (Tabla 12: 30/min). Súbalo en demo para sincronizar rápido.
DEVICE_RATE_LIMIT_PER_MIN=30
# RN-04: «sin señal» tras N intervalos de muestreo sin comunicación
SIN_SENAL_FACTOR=3
# Cada cuántos segundos el worker revisa «sin señal». Debe ser menor que SIN_SENAL_FACTOR × intervalo
# de muestreo (10 s × 3 = 30 s en demo); con 60 s un corte breve no alcanza a registrarse.
WORKER_SIN_SENAL_CADA_S=10

# Notificaciones (opcional; sin SMTP las alertas quedan «proveedor no configurado»)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Solo demo: enviar TODOS los avisos únicamente a esta dirección (los usuarios sembrados son ficticios).
NOTIFICACIONES_SOLO_A=

# ----- Solo desarrollo / demostración (NUNCA en producción) -----
SEMBRAR_DATOS_PRUEBA=true
SEED_INTERVALO_S=10
SEED_PASSWORD_ADMIN=AdminAqua2026
SEED_PASSWORD_SUPERVISOR=SuperAqua2026
SEED_PASSWORD_ENCARGADO=EncargadoAqua2026
DEMO_MODE=true
SIM_CONTROL_TOKEN=cambiar-token-control-simulador
DEMO_ENCARGADO_EMAIL=encargado@aquaplants.cl
DEMO_ENCARGADO_PASSWORD=EncargadoAqua2026
SIM_COLA_BYTES=524288
SIM_BACKOFF_BASE_MS=3000
